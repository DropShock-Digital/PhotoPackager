outputs/
temp_uploads/
dist/
build/
*.dmg
*.zip
*.log
test_output.txt

# Source trees that are not needed for the container image
.github/
docs/
gui/
cli/
assets/

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
