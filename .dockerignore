.git
.gitignore

# Node and Python dependencies
node_modules/
frontend/node_modules/
.venv/
.venv*
venv/
venv_mac/
venv_windows/

# Python caches and test artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

